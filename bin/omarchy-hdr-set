#!/usr/bin/env bash
# Changes HDR settings for one monitor: updates per-monitor state, applies a color-only rule live via
# `hyprctl eval`, drives an already running hyprsunset (SDR only), and regenerates ~/.config/hypr/hdr.lua.
#
# Rules are keyed by `desc:<description>` and carry only color and vrr keys. Hyprland merges a rule into
# the earlier one with the identical output string, so mode/position/scale from monitors.lua stay intact.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATUS_BIN="$PLUGIN_DIR/bin/omarchy-hdr-status"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/caioniehues.hdr"
STATE_FILE="$STATE_DIR/state.json"
HDR_CONF="$HOME/.config/hypr/hdr.lua"

TARGET_MON="${HDR_MONITOR:-}"
if [[ "${1:-}" == "--monitor" && -n "${2:-}" ]]; then
  TARGET_MON="$2"
  shift 2
fi

ACTION="${1:-toggle}"
PARAM="${2:-}"
EXTRA="${3:-}"

# One saved monitor entry (+ .desc) -> one hl.monitor call. tojson keeps strings safe as Lua literals.
RULE_JQ='
def rule:
  (if .enabled then {cm, b: .sdrBrightness, s: .sdrSaturation} else {cm: "srgb", b: 1, s: 1} end) as $c |
  "hl.monitor({ output = \("desc:" + .desc | tojson), cm = \($c.cm | tojson), " +
  "sdrbrightness = \($c.b), sdrsaturation = \($c.s), " +
  "sdr_min_luminance = \(.edidMinLuminance), sdr_max_luminance = \(.sdrMaxLuminance), " +
  "min_luminance = \(.edidMinLuminance), max_luminance = \(.peakOverride // .edidMaxLuminance), " +
  "max_avg_luminance = \(.edidAvgLuminance), sdr_eotf = \(.sdrEotf // "gamma22" | tojson), " +
  "vrr = \(.vrr // 2) })";'

notify_hdr() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Omarchy HDR" -i "video-display" \
      -h string:x-canonical-private-synchronous:hdr-status \
      "$1" "$2" >/dev/null 2>&1 || true
  fi
}

# Talks to the hyprsunset Omarchy already runs; never starts or stops one. Prints the clamped Kelvin.
apply_color_temp() {
  local temp
  temp=$(awk -v t="$1" 'BEGIN { v = int(t + 0.5); if (v < 3000) v = 3000; if (v > 9000) v = 9000; print v }')
  if pgrep -x hyprsunset >/dev/null 2>&1; then
    if [[ "$temp" -eq 6500 ]]; then
      hyprctl hyprsunset identity >/dev/null 2>&1 || true
    else
      hyprctl hyprsunset temperature "$temp" >/dev/null 2>&1 || true
    fi
  fi
  echo "$temp"
}

read_state() {
  if [[ -f "$STATE_FILE" ]] && jq -e 'type == "object"' "$STATE_FILE" >/dev/null 2>&1; then
    cat "$STATE_FILE"
  else
    echo "{}"
  fi
}

write_state() {
  mkdir -p "$STATE_DIR"
  cat > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
}

reset_all() {
  apply_color_temp 6500 >/dev/null
  # hyprsunset.pid: left behind by versions that spawned their own hyprsunset.
  rm -f "$HDR_CONF" "$STATE_FILE" "$STATE_DIR/hyprsunset.pid"
  rmdir "$STATE_DIR" 2>/dev/null || true

  # Reload restores the user's own monitors.lua rules.
  hyprctl reload >/dev/null 2>&1 || true

  notify_hdr "HDR Display" "Configuration restored to its original state"
  exit 0
}

[[ "$ACTION" == "reset" ]] && reset_all

# 1. Current status & capabilities
CURRENT_JSON=$("$STATUS_BIN" ${TARGET_MON:+"$TARGET_MON"})

CONNECTOR=$(jq -r '.monitor' <<<"$CURRENT_JSON")
DESC=$(jq -r '.description' <<<"$CURRENT_JSON")
EDID_MAX_L=$(jq -r '.edidMaxLuminance' <<<"$CURRENT_JSON")
EDID_AVG_L=$(jq -r '.edidAvgLuminance' <<<"$CURRENT_JSON")
EDID_MIN_L=$(jq -r '.edidMinLuminance' <<<"$CURRENT_JSON")
IS_ENABLED=$(jq -r '.enabled' <<<"$CURRENT_JSON")
SDR_B=$(jq -r '.sdrBrightness' <<<"$CURRENT_JSON")
SDR_S=$(jq -r '.sdrSaturation' <<<"$CURRENT_JSON")
SDR_MAX_L=$(jq -r '.sdrMaxLuminance' <<<"$CURRENT_JSON")
CM_PRESET=$(jq -r '.cm' <<<"$CURRENT_JSON")
SDR_EOTF=$(jq -r '.sdrEotf' <<<"$CURRENT_JSON")
VRR=$(jq -r '.vrr' <<<"$CURRENT_JSON")
PEAK_OVERRIDE=$(jq -r '.peakOverride' <<<"$CURRENT_JSON")
PRESET=$(jq -r '.preset' <<<"$CURRENT_JSON")
COLOR_TEMP=$(jq -r '.colorTemp' <<<"$CURRENT_JSON")

# Fast path: color temperature only touches hyprsunset and the global colorTemp.
# hyprsunset's CTM is applied after PQ encoding, so under HDR it tints the picture instead of
# shifting the white point (hyprwm/Hyprland discussion #15747).
if [[ "$ACTION" == "temperature" ]]; then
  if [[ "$(jq -r '.anyHdrEnabled' <<<"$CURRENT_JSON")" == "true" ]]; then
    echo "omarchy-hdr-set: color temperature is unavailable while a monitor is in HDR" >&2
    exit 2
  fi
  if ! pgrep -x hyprsunset >/dev/null 2>&1; then
    echo "omarchy-hdr-set: hyprsunset is not running" >&2
    exit 1
  fi
  [[ -n "$PARAM" ]] && COLOR_TEMP=$(apply_color_temp "$PARAM")
  STATE=$(read_state | jq --argjson ct "$COLOR_TEMP" '.colorTemp = $ct')
  write_state <<<"$STATE"
  exit 0
fi

# 2. Apply the action to the in-memory settings
case "$ACTION" in
  toggle|on|off)
    case "$ACTION" in
      toggle) IS_ENABLED=$([[ "$IS_ENABLED" == "true" ]] && echo "false" || echo "true") ;;
      on) IS_ENABLED="true" ;;
      off) IS_ENABLED="false" ;;
    esac
    # The SDR preset has desktop values with HDR off, so switching HDR on lands on desktop.
    [[ "$IS_ENABLED" == "true" && "$PRESET" == "sdr" ]] && PRESET="desktop"
    ;;
  apply)
    [[ -n "$PARAM" ]] && SDR_B="$PARAM"
    [[ -n "$EXTRA" ]] && SDR_S="$EXTRA"
    [[ -n "${4:-}" ]] && SDR_MAX_L="$4"
    [[ -n "${5:-}" ]] && CM_PRESET="$5"
    PRESET="custom"
    ;;
  sdr_brightness) [[ -n "$PARAM" ]] && SDR_B="$PARAM"; PRESET="custom" ;;
  sdr_saturation) [[ -n "$PARAM" ]] && SDR_S="$PARAM"; PRESET="custom" ;;
  sdr_max_lum) [[ -n "$PARAM" ]] && SDR_MAX_L="$PARAM"; PRESET="custom" ;;
  cm) [[ -n "$PARAM" ]] && CM_PRESET="$PARAM"; PRESET="custom" ;;
  sdr_eotf) [[ -n "$PARAM" ]] && SDR_EOTF="$PARAM"; PRESET="custom" ;;
  vrr) [[ -n "$PARAM" ]] && VRR="$PARAM" ;;
  peak)
    # Manual HDR peak (nits) for panels whose real peak differs from the EDID; "edid" clears it.
    if [[ "$PARAM" == "edid" ]]; then
      PEAK_OVERRIDE=null
    elif [[ "$PARAM" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      PEAK_OVERRIDE=$(awk -v p="$PARAM" 'BEGIN { v = int(p + 0.5); if (v < 250) v = 250; if (v > 1500) v = 1500; print v }')
    else
      echo "omarchy-hdr-set: peak must be nits or 'edid'" >&2; exit 2
    fi
    ;;
  preset)
    SDR_WHITE=$(jq -r '.presetSdrWhite' <<<"$CURRENT_JSON")
    # All presets use cm=hdr, saturation 1, gamma 2.2, 6500 K; sdr sends srgb only because it disables HDR.
    #             enabled boost sdr-white
    case "$PARAM" in
      desktop) set -- true  1     "$SDR_WHITE" ;;
      bright)  set -- true  1.2   "$SDR_WHITE" ;;
      cinema)  set -- true  1     200 ;;
      sdr)     set -- false 1     "$SDR_WHITE" ;;
      *) echo "omarchy-hdr-set: unknown preset '$PARAM'" >&2; exit 2 ;;
    esac
    IS_ENABLED=$1 SDR_B=$2 SDR_S=1 SDR_MAX_L=$3 CM_PRESET=hdr SDR_EOTF=gamma22 PRESET="$PARAM" COLOR_TEMP=6500
    [[ "$IS_ENABLED" == "false" ]] && apply_color_temp 6500 >/dev/null
    ;;
  *) echo "omarchy-hdr-set: unknown action '$ACTION'" >&2; exit 2 ;;
esac

# No color temperature under HDR (see the temperature fast path). Reset unconditionally: something
# else (e.g. a nightlight profile) may have tinted the shared hyprsunset.
[[ "$IS_ENABLED" == "true" ]] && COLOR_TEMP=$(apply_color_temp 6500)

# 3. Validate user input (it ends up in Lua), then persist per-monitor state keyed by description
for v in "$SDR_B" "$SDR_S" "$SDR_MAX_L"; do
  [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "omarchy-hdr-set: not a number: '$v'" >&2; exit 2; }
done
case "$CM_PRESET" in
  auto|srgb|dcip3|dp3|adobe|wide|edid|hdr|hdredid) ;;
  *) echo "omarchy-hdr-set: unknown color space '$CM_PRESET'" >&2; exit 2 ;;
esac
case "$SDR_EOTF" in
  gamma22|srgb) ;;
  *) echo "omarchy-hdr-set: unknown SDR EOTF '$SDR_EOTF' (gamma22|srgb)" >&2; exit 2 ;;
esac
# 0 off, 1 always, 2 fullscreen only (Hyprland's 3, fullscreen games/video only, isn't offered).
[[ "$VRR" =~ ^[012]$ ]] || { echo "omarchy-hdr-set: VRR must be 0, 1 or 2" >&2; exit 2; }

STATE=$(read_state | jq \
  --arg desc "$DESC" \
  --argjson enabled "$IS_ENABLED" \
  --argjson sdrB "$SDR_B" \
  --argjson sdrS "$SDR_S" \
  --argjson sdrMaxL "$SDR_MAX_L" \
  --arg cm "$CM_PRESET" \
  --arg sdrEotf "$SDR_EOTF" \
  --argjson vrr "$VRR" \
  --argjson peakOverride "$PEAK_OVERRIDE" \
  --arg preset "$PRESET" \
  --argjson edidMinL "$EDID_MIN_L" \
  --argjson edidMaxL "$EDID_MAX_L" \
  --argjson edidAvgL "$EDID_AVG_L" \
  --argjson ct "$COLOR_TEMP" '
  .colorTemp = $ct |
  .monitors[$desc] = {
    enabled: $enabled,
    sdrBrightness: $sdrB,
    sdrSaturation: $sdrS,
    sdrMaxLuminance: $sdrMaxL,
    cm: $cm,
    sdrEotf: $sdrEotf,
    vrr: $vrr,
    peakOverride: $peakOverride,
    preset: $preset,
    edidMinLuminance: $edidMinL,
    edidMaxLuminance: $edidMaxL,
    edidAvgLuminance: $edidAvgL
  }')
write_state <<<"$STATE"

# 4. Apply live. Hyprland's rule compare ignores vrr/sdr_eotf (and possibly max_luminance) and applies
# them on the *next* rule change, so actions that can change them first nudge SDR white by 1 nit.
MONITOR_ENTRY=$(jq -c --arg desc "$DESC" '.monitors[$desc] + {desc: $desc}' <<<"$STATE")
if [[ "$ACTION" =~ ^(sdr_eotf|vrr|peak|preset)$ ]]; then
  hyprctl eval "$(jq -r "$RULE_JQ"' .sdrMaxLuminance += 1 | rule' <<<"$MONITOR_ENTRY")" >/dev/null 2>&1 || true
fi
hyprctl eval "$(jq -r "$RULE_JQ"' rule' <<<"$MONITOR_ENTRY")" >/dev/null 2>&1 || true

if [[ "$IS_ENABLED" == "true" ]]; then
  [[ "$ACTION" =~ ^(toggle|on|preset)$ ]] &&
    notify_hdr "HDR Display ($CONNECTOR)" "HDR enabled ($CM_PRESET • ${SDR_MAX_L} nits)"
else
  [[ "$ACTION" =~ ^(toggle|off|preset)$ ]] &&
    notify_hdr "HDR Display ($CONNECTOR)" "Standard SDR mode enabled"
fi

# 5. Regenerate hdr.lua for every saved monitor (loaded right after monitors.lua)
mkdir -p "$(dirname "$HDR_CONF")"
{
  echo "-- HDR & color management for Omarchy / Hyprland."
  echo "-- Auto-generated by the caioniehues.hdr plugin; edits are overwritten."
  jq -r "$RULE_JQ"' .monitors | to_entries[] | .value + {desc: .key} | rule' <<<"$STATE"
} > "$HDR_CONF"

exit 0
