#!/usr/bin/env bash
# Returns rich JSON status of HDR, EDID capabilities, available monitors, and color controls.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/caioniehues.hdr"
STATE_FILE="$STATE_DIR/state.json"

RAW_MONITORS=$(hyprctl monitors -j 2>/dev/null || true)
if [[ -n "$RAW_MONITORS" ]] && jq -e 'type == "array"' <<<"$RAW_MONITORS" >/dev/null 2>&1; then
  MONITORS_JSON="$RAW_MONITORS"
else
  MONITORS_JSON="[]"
fi

# Read EDID capabilities for a given connector name (e.g. eDP-1, DP-2).
# Outputs: "<hdr_capable> <max_lum> <avg_lum> <min_lum>"
read_edid_caps() {
  local mon="$1"
  local edid_file=""
  local hdr_capable="false"
  local max_l=300
  local avg_l=250
  local min_l=0.05

  for candidate in /sys/class/drm/*-"$mon"/edid; do
    if [[ -r "$candidate" ]]; then
      edid_file="$candidate"
      break
    fi
  done

  if [[ -n "$edid_file" ]] && command -v edid-decode >/dev/null 2>&1; then
    local decoded
    decoded=$(edid-decode "$edid_file" 2>/dev/null || true)

    if grep -qE "HDR Static Metadata Data Block|SMPTE ST2084|Desired content max luminance" <<<"$decoded"; then
      hdr_capable="true"
      max_l=617
      avg_l=400
      min_l=0.005
    fi

    local max_val avg_val min_val parsed
    max_val=$(grep -m1 "Desired content max luminance" <<<"$decoded" | sed -nE 's/.*\(([0-9.]+).*/\1/p' || true)
    avg_val=$(grep -m1 "Desired content max frame-average luminance" <<<"$decoded" | sed -nE 's/.*\(([0-9.]+).*/\1/p' || true)
    min_val=$(grep -m1 "Desired content min luminance" <<<"$decoded" | sed -nE 's/.*\(([0-9.]+).*/\1/p' || true)

    if [[ -n "$max_val" ]]; then
      parsed=$(awk -v v="$max_val" 'BEGIN { print int(v + 0.5) }' 2>/dev/null || true)
      [[ -n "$parsed" && "$parsed" -gt 0 ]] && max_l="$parsed"
    fi
    if [[ -n "$avg_val" ]]; then
      parsed=$(awk -v v="$avg_val" 'BEGIN { print int(v + 0.5) }' 2>/dev/null || true)
      [[ -n "$parsed" && "$parsed" -gt 0 ]] && avg_l="$parsed"
    fi
    if [[ -n "$min_val" ]] && awk -v v="$min_val" 'BEGIN { exit !(v >= 0) }' 2>/dev/null; then
      min_l="$min_val"
    fi
  fi

  echo "$hdr_capable $max_l $avg_l $min_l"
}

# 1. Determine target monitor (CLI arg > env > focused > first > eDP-1)
TARGET_MON="${1:-${HDR_MONITOR:-}}"
if [[ -z "$TARGET_MON" ]]; then
  TARGET_MON=$(jq -r '(.[] | select(.focused == true) | .name) // (.[0] | .name) // "eDP-1"' <<<"$MONITORS_JSON" 2>/dev/null || echo "eDP-1")
fi
[[ -z "$TARGET_MON" || "$TARGET_MON" == "null" ]] && TARGET_MON="eDP-1"

MON_INFO=$(jq -c --arg m "$TARGET_MON" '(.[] | select(.name == $m)) // empty' <<<"$MONITORS_JSON" 2>/dev/null || true)

if [[ -z "$MON_INFO" || "$MON_INFO" == "null" ]]; then
  MON_DESC="Display $TARGET_MON"
  SCALE="1.0"
  HYPR_CM="srgb"
else
  MON_DESC=$(jq -r '.description // .name // "Display"' <<<"$MON_INFO" 2>/dev/null || echo "Display")
  SCALE=$(jq -r '.scale // 1.0' <<<"$MON_INFO" 2>/dev/null || echo "1.0")
  HYPR_CM=$(jq -r '.colorManagementPreset // "srgb"' <<<"$MON_INFO" 2>/dev/null || echo "srgb")
fi

# 2. Extract EDID capabilities for target monitor
read -r HDR_CAPABLE EDID_MAX_L EDID_AVG_L EDID_MIN_L <<<"$(read_edid_caps "$TARGET_MON")"

# Build monitors list for UI selector
MONITORS_LIST="[]"
if [[ "$MONITORS_JSON" != "[]" ]]; then
  MONITORS_LIST=$(jq -c '[.[] | {name: .name, description: (.description // .name), focused: (.focused // false), scale: (.scale // 1.0)}]' <<<"$MONITORS_JSON" 2>/dev/null || echo "[]")
fi

# 3. Read persistent user state (per-monitor XDG state)
ACTIVE_STATE_FILE=""
if [[ -f "$STATE_FILE" ]] && jq -e . "$STATE_FILE" >/dev/null 2>&1; then
  ACTIVE_STATE_FILE="$STATE_FILE"
fi

DEFAULT_ENABLED=$([[ "$HYPR_CM" == "hdr" ]] && echo "true" || echo "false")
ENABLED="$DEFAULT_ENABLED"
SDR_B="1.80"
SDR_S="1.15"
SDR_MAX_L="$EDID_MAX_L"
CM_PRESET=$([[ "$HDR_CAPABLE" == "true" ]] && echo "hdr" || echo "srgb")
BL_SYNC="true"
PRESET=$([[ "$HDR_CAPABLE" == "true" ]] && echo "vivid" || echo "eco")
COLOR_TEMP="6500"

if [[ -n "$ACTIVE_STATE_FILE" ]]; then
  COLOR_TEMP=$(jq -r '.colorTemp // 6500' "$ACTIVE_STATE_FILE" 2>/dev/null || echo "6500")
  MON_STATE=$(jq -c --arg m "$TARGET_MON" '
    if .monitors[$m] then .monitors[$m]
    elif (.monitor == $m) or (.monitors == null and .enabled != null) then .
    else empty
    end
  ' "$ACTIVE_STATE_FILE" 2>/dev/null || true)

  if [[ -n "$MON_STATE" ]]; then
    ENABLED=$(jq -r --argjson d "$DEFAULT_ENABLED" 'if .enabled != null then .enabled else $d end' <<<"$MON_STATE")
    SDR_B=$(jq -r '.sdrBrightness // 1.80' <<<"$MON_STATE")
    SDR_S=$(jq -r '.sdrSaturation // 1.15' <<<"$MON_STATE")
    SDR_MAX_L=$(jq -r --argjson d "$EDID_MAX_L" '.sdrMaxLuminance // $d' <<<"$MON_STATE")
    CM_PRESET=$(jq -r --arg d "$CM_PRESET" '.cm // $d' <<<"$MON_STATE")
    BL_SYNC=$(jq -r 'if .backlightSync != null then .backlightSync else true end' <<<"$MON_STATE")
    PRESET=$(jq -r --arg d "$PRESET" '.preset // $d' <<<"$MON_STATE")
  fi
fi

# 4. Emit complete JSON
jq -n \
  --arg mon "$TARGET_MON" \
  --arg desc "$MON_DESC" \
  --argjson scale "$SCALE" \
  --argjson enabled "$ENABLED" \
  --argjson hdrCapable "$HDR_CAPABLE" \
  --argjson sdrBrightness "$SDR_B" \
  --argjson sdrSaturation "$SDR_S" \
  --argjson sdrMaxLuminance "$SDR_MAX_L" \
  --argjson maxLuminance "$EDID_MAX_L" \
  --argjson edidMaxLuminance "$EDID_MAX_L" \
  --argjson edidAvgLuminance "$EDID_AVG_L" \
  --argjson edidMinLuminance "$EDID_MIN_L" \
  --arg cm "$CM_PRESET" \
  --argjson backlightSync "$BL_SYNC" \
  --arg preset "$PRESET" \
  --argjson colorTemp "$COLOR_TEMP" \
  --argjson monitors "$MONITORS_LIST" \
  '{
    monitor: $mon,
    monitorName: $desc,
    scale: $scale,
    enabled: $enabled,
    hdrCapable: $hdrCapable,
    sdrBrightness: $sdrBrightness,
    sdrSaturation: $sdrSaturation,
    sdrMaxLuminance: $sdrMaxLuminance,
    maxLuminance: $maxLuminance,
    edidMaxLuminance: $edidMaxLuminance,
    edidAvgLuminance: $edidAvgLuminance,
    edidMinLuminance: $edidMinLuminance,
    cm: $cm,
    backlightSync: $backlightSync,
    preset: $preset,
    colorTemp: $colorTemp,
    monitors: $monitors
  }'
