#!/usr/bin/env bash
# Prints JSON status for one monitor: identity, EDID HDR capabilities, saved settings, and the monitor list.
# Usage: omarchy-hdr-status [connector|description]   (default: $HDR_MONITOR, else focused, else first)
set -euo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/caioniehues.hdr/state.json"

MONITORS_JSON=$(hyprctl monitors -j 2>/dev/null || true)
jq -e 'type == "array"' <<<"$MONITORS_JSON" >/dev/null 2>&1 || MONITORS_JSON="[]"

TARGET="${1:-${HDR_MONITOR:-}}"
MON_INFO=$(jq -c --arg m "$TARGET" '
  if $m != "" then first(.[] | select(.name == $m or .description == $m))
  else first(.[] | select(.focused)) // .[0] end // empty' <<<"$MONITORS_JSON")
if [[ -z "$MON_INFO" ]]; then
  echo "omarchy-hdr-status: no monitor found${TARGET:+ matching '$TARGET'}" >&2
  exit 1
fi
CONNECTOR=$(jq -r '.name' <<<"$MON_INFO")

# EDID capabilities for a connector. Outputs: "<hdr_capable> <max_nits> <avg_nits> <min_nits>".
# Without an HDR static metadata block the panel is treated as a plain SDR display.
read_edid_caps() {
  local edid_file="" decoded candidate
  local hdr_capable="false" max_l=300 avg_l=250 min_l=0.05
  for candidate in "${HDR_SYSFS_DRM:-/sys/class/drm}"/*-"$1"/edid; do
    [[ -r "$candidate" ]] && { edid_file="$candidate"; break; }
  done

  if [[ -n "$edid_file" ]] && command -v edid-decode >/dev/null 2>&1; then
    decoded=$(edid-decode "$edid_file" 2>/dev/null || true)
    if grep -q "SMPTE ST2084" <<<"$decoded"; then
      hdr_capable="true"
      local v
      v=$(sed -nE 's/.*Desired content max luminance: .*\(([0-9.]+) cd.*/\1/p' <<<"$decoded" | head -1)
      [[ -n "$v" ]] && max_l=$(awk -v v="$v" 'BEGIN { print int(v + 0.5) }')
      v=$(sed -nE 's/.*Desired content max frame-average luminance: .*\(([0-9.]+) cd.*/\1/p' <<<"$decoded" | head -1)
      [[ -n "$v" ]] && avg_l=$(awk -v v="$v" 'BEGIN { print int(v + 0.5) }')
      v=$(sed -nE 's/.*Desired content min luminance: .*\(([0-9.]+) cd.*/\1/p' <<<"$decoded" | head -1)
      [[ -n "$v" ]] && min_l=$(awk -v v="$v" 'BEGIN { print v + 0 }')
    fi
  fi
  echo "$hdr_capable $max_l $avg_l $min_l"
}
read -r HDR_CAPABLE EDID_MAX_L EDID_AVG_L EDID_MIN_L <<<"$(read_edid_caps "$CONNECTOR")"

STATE="{}"
if [[ -f "$STATE_FILE" ]] && jq -e 'type == "object"' "$STATE_FILE" >/dev/null 2>&1; then
  STATE=$(<"$STATE_FILE")
fi

jq -n \
  --argjson mon "$MON_INFO" \
  --argjson monitors "$MONITORS_JSON" \
  --argjson state "$STATE" \
  --argjson hdrCapable "$HDR_CAPABLE" \
  --argjson edidMax "$EDID_MAX_L" \
  --argjson edidAvg "$EDID_AVG_L" \
  --argjson edidMin "$EDID_MIN_L" '
  def or_default($d): if . == null then $d else . end;
  # SDR white for presets: the EDID frame-average (what an OLED sustains full-screen), rounded to 10 nits.
  # Unconfigured monitors start on the desktop/sdr preset values.
  (($edidAvg / 10 | round) * 10) as $white |
  ($state.monitors[$mon.description] // {}) as $s |
  {
    monitor: $mon.name,
    description: $mon.description,
    monitorName: $mon.description,
    hdrCapable: $hdrCapable,
    enabled: ($s.enabled | or_default($mon.colorManagementPreset == "hdr")),
    sdrBrightness: ($s.sdrBrightness | or_default(1)),
    sdrSaturation: ($s.sdrSaturation | or_default(1)),
    sdrMaxLuminance: ($s.sdrMaxLuminance | or_default($white)),
    edidMaxLuminance: $edidMax,
    edidAvgLuminance: $edidAvg,
    edidMinLuminance: $edidMin,
    presetSdrWhite: $white,
    cm: ($s.cm | or_default(if $hdrCapable then "hdr" else "srgb" end)),
    preset: ($s.preset | or_default(if $hdrCapable then "desktop" else "sdr" end)),
    colorTemp: ($state.colorTemp | or_default(6500)),
    monitors: [$monitors[] | {name, description, focused: (.focused // false)}]
  }'
