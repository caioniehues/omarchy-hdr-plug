#!/bin/bash
# Sets HDR parameters and updates ~/.config/hypr/hdr.lua
ACTION="${1:-toggle}" # on | off | toggle | sdr_brightness | sdr_saturation | sdr_max_lum
PARAM="${2:-}"
MONITOR="eDP-1"
HDR_CONF="$HOME/.config/hypr/hdr.lua"
STATUS_BIN="$HOME/.config/omarchy/plugins/vedix.hdr/bin/omarchy-hdr-status"

CURRENT_INFO=$("$STATUS_BIN" "$MONITOR")
IS_ENABLED=$(echo "$CURRENT_INFO" | jq -r '.enabled // true')
SDR_B=$(echo "$CURRENT_INFO" | jq -r '.sdrBrightness // 1.4')
SDR_S=$(echo "$CURRENT_INFO" | jq -r '.sdrSaturation // 1.0')
SDR_MAX_L=$(echo "$CURRENT_INFO" | jq -r '.sdrMaxLuminance // 400')
MAX_L=$(echo "$CURRENT_INFO" | jq -r '.maxLuminance // 617')

# Fallbacks if empty
[[ -z "$SDR_B" || "$SDR_B" == "null" ]] && SDR_B="1.4"
[[ -z "$SDR_S" || "$SDR_S" == "null" ]] && SDR_S="1.0"
[[ -z "$SDR_MAX_L" || "$SDR_MAX_L" == "null" ]] && SDR_MAX_L="400"
[[ -z "$MAX_L" || "$MAX_L" == "null" ]] && MAX_L="617"

case "$ACTION" in
  toggle)
    if [[ "$IS_ENABLED" == "true" ]]; then
      NEW_ENABLED="false"
    else
      NEW_ENABLED="true"
    fi
    ;;
  on)
    NEW_ENABLED="true"
    ;;
  off)
    NEW_ENABLED="false"
    ;;
  sdr_brightness)
    NEW_ENABLED="$IS_ENABLED"
    [[ -n "$PARAM" ]] && SDR_B="$PARAM"
    ;;
  sdr_saturation)
    NEW_ENABLED="$IS_ENABLED"
    [[ -n "$PARAM" ]] && SDR_S="$PARAM"
    ;;
  sdr_max_lum)
    NEW_ENABLED="$IS_ENABLED"
    [[ -n "$PARAM" ]] && SDR_MAX_L="$PARAM"
    ;;
esac

SCALE=$(hyprctl monitors -j | jq -r --arg m "$MONITOR" '.[] | select(.name == $m) | .scale // 2')
[[ -z "$SCALE" || "$SCALE" == "null" ]] && SCALE="2"

if [[ "$NEW_ENABLED" == "true" ]]; then
  # Apply HDR dynamically
  hyprctl eval "hl.monitor({ output = \"$MONITOR\", mode = \"preferred\", position = \"auto\", scale = $SCALE, bitdepth = 10, cm = \"hdr\", sdrbrightness = $SDR_B, sdrsaturation = $SDR_S, sdr_min_luminance = 0.005, sdr_max_luminance = $SDR_MAX_L, min_luminance = 0.005, max_luminance = $MAX_L, max_avg_luminance = $SDR_MAX_L })" >/dev/null 2>&1

  # Update persistent config
  cat << LUA_EOF > "$HDR_CONF"
-- HDR & Color Management Configuration for Omarchy / Hyprland
-- Calibrated for Samsung OLED ATNA56AC02-1 (eDP-1)

hl.config({
  quirks = {
    skip_non_kms_dmabuf_formats = true,
  },
})

hl.monitor({
  output = "",
  mode = "preferred",
  position = "auto",
  scale = "auto",
})

hl.monitor({
  output = "eDP-1",
  mode = "preferred",
  position = "auto",
  scale = $SCALE,
  bitdepth = 10,
  cm = "hdr",
  sdrbrightness = $SDR_B,
  sdrsaturation = $SDR_S,
  sdr_min_luminance = 0.005,
  sdr_max_luminance = $SDR_MAX_L,
  min_luminance = 0.005,
  max_luminance = $MAX_L,
  max_avg_luminance = $SDR_MAX_L,
})

local bl_path = "/sys/class/backlight/amdgpu_bl1/brightness"
local bl_max_path = "/sys/class/backlight/amdgpu_bl1/max_brightness"

local function read_num(path)
  local f = io.open(path, "r")
  if not f then return nil end
  local v = tonumber(f:read("*l"))
  f:close()
  return v
end

local bl_max = read_num(bl_max_path) or 400000
local last_bl = nil
local edp_name = "eDP-1"

local function sync_hdr_brightness()
  local cur = read_num(bl_path)
  if not cur or cur == last_bl then return end
  last_bl = cur

  local ratio = math.max(0.01, math.min(1.0, cur / bl_max))
  local sdr_b = tonumber(string.format("%.3f", 0.10 + ratio * (${SDR_B} - 0.10)))
  local mon = hl.get_monitor(edp_name)
  local scale = (mon and mon.scale) or 2

  hl.monitor({
    output = edp_name,
    mode = "preferred",
    position = "auto",
    scale = scale,
    bitdepth = 10,
    cm = "hdr",
    sdrbrightness = sdr_b,
    sdrsaturation = $SDR_S,
    sdr_min_luminance = 0.005,
    sdr_max_luminance = $SDR_MAX_L,
    min_luminance = 0.005,
    max_luminance = $MAX_L,
    max_avg_luminance = $SDR_MAX_L,
  })
end

sync_hdr_brightness()
hl.timer(sync_hdr_brightness, { timeout = 100, type = "repeat" })
LUA_EOF

else
  # Apply SDR calibrated (10-bit color, sdr_max_luminance = 400 nits, full range)
  hyprctl eval "hl.monitor({ output = \"$MONITOR\", mode = \"preferred\", position = \"auto\", scale = $SCALE, bitdepth = 10, cm = \"srgb\", sdrbrightness = 1.4, sdrsaturation = 1.0, sdr_min_luminance = 0.005, sdr_max_luminance = 400, min_luminance = 0.005, max_luminance = 617 })" >/dev/null 2>&1

  cat << LUA_EOF > "$HDR_CONF"
-- HDR is currently disabled. High-brightness 10-bit SDR active.
hl.config({
  quirks = {
    skip_non_kms_dmabuf_formats = true,
  },
})

hl.monitor({
  output = "eDP-1",
  mode = "preferred",
  position = "auto",
  scale = $SCALE,
  bitdepth = 10,
  cm = "srgb",
  sdrbrightness = 1.4,
  sdrsaturation = 1.0,
  sdr_min_luminance = 0.005,
  sdr_max_luminance = 400,
  min_luminance = 0.005,
  max_luminance = 617,
})
LUA_EOF
fi

hyprctl reload >/dev/null 2>&1
